
# Email notifications (Phase 7). Leave SMTP_HOST empty to switch email off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Overdue job (Phase 8) and points (Phase 9)
OVERDUE_DAYS=3
OVERDUE_CHECK_MINUTES=60
SCHEDULER_ENABLED=true
POINTS_COMPLAINT_CREATED=10
POINTS_COMPLAINT_UPVOTED=2
POINTS_COMPLAINT_RESOLVED=20

# Security (Phase 11)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_WINDOW_SECONDS=900
TRUST_PROXY_HEADERS=false
MAX_JSON_BODY_KB=256
